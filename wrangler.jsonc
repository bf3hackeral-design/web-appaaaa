{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appaaaa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "cc7976a4-2639-4ab2-9a05-d09b2d9ce665","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "58b10e7a9a8748a5a18e545733c9ead2" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
